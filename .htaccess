# BEGIN Block-Attacker-IPs (added 2026-07-20: sqlmap SQLi via CF7 /about-us/)
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{REMOTE_ADDR} ^78\.40\.197\.138$
RewriteRule .* - [F,L]
</IfModule>
# END Block-Attacker-IPs

# BEGIN WPRM-WAF
<IfModule mod_rewrite.c>
RewriteEngine On
# 1) WPRM C2 auth header present -> block
RewriteCond %{HTTP:X-WPRM-Secret-Key} . [NC]
RewriteRule .* - [F,L]
# 2) backdoor routes / paths / actions (URI or query) -> block
RewriteCond %{REQUEST_URI} (wprm-agent/v1|motor-heuristic-compat|wp-health\.php|wprm-agent\.php|wprm-emergency\.php|wp-media-recovery\.php|wp-performance-monitor\.php) [NC,OR]
RewriteCond %{QUERY_STRING} (wprm_fm=|action=motor-heuristic-compat|ev_data=|_wprm) [NC]
RewriteRule .* - [F,L]
# 3) dropped XSH webshells (sgz-<rand>.php) -> block
RewriteRule ^sgz-[a-z0-9]+\.php$ - [F,L,NC]
# 4) random-named .xcf "plugin" dirs -> block
RewriteRule \.xcf/ - [F,L,NC]
</IfModule>
# END WPRM-WAF
# BEGIN CSP-ENFORCE
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://static.hotjar.com https://www.googletagmanager.com https://www.google-analytics.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://maxcdn.bootstrapcdn.com https://maps.googleapis.com https://www.google.com https://www.gstatic.com https://cdn-cookieyes.com https://platform-api.sharethis.com https://connect.facebook.net https://s.ytimg.com https://stats.wp.com https://*.wp.com https://static.cloudflareinsights.com https://res.cloudinary.com https://translate.google.com https://translate.googleapis.com https://translate-pa.googleapis.com https://snap.licdn.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://maxcdn.bootstrapcdn.com https://res.cloudinary.com https://www.gstatic.com https://translate.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com https://maxcdn.bootstrapcdn.com; connect-src 'self' https://cdn.jsdelivr.net https://www.google-analytics.com https://region1.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://fonts.googleapis.com https://*.wp.com https://static.cloudflareinsights.com https://cloudflareinsights.com https://translate.googleapis.com https://translate-pa.googleapis.com https://px.ads.linkedin.com https://www.google.com https://cdn-cookieyes.com https://log.cookieyes.com; media-src 'self' https:; frame-src 'self' https://accounts.google.com https://docs.google.com https://www.youtube.com https://www.youtube-nocookie.com https://www.google.com https://bookings.hotelrez.co.uk https://www.facebook.com https://player.vimeo.com https://drive.google.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https:; frame-ancestors 'self'; report-uri /?wp_csp_report=1"
</IfModule>
# END CSP-ENFORCE
# BEGIN Hardening
<FilesMatch "(^\.user\.ini$|wp-config\.php|\.sql$|\.zip$|\.tar\.gz$|\.gz$|debug\.log|^readme\.html$|^license\.txt$)">
  Require all denied
</FilesMatch>
<Files xmlrpc.php>
  Require all denied
</Files>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == '"on"'"
  Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=()"
</IfModule>
# END Hardening


# BEGIN WordPress
# The directives (lines) between "BEGIN WordPress" and "END WordPress" are
# dynamically generated, and should only be modified via WordPress filters.
# Any changes to the directives between these markers will be overwritten.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>

# END WordPress

# Wordfence WAF
<IfModule LiteSpeed>
php_value auto_prepend_file '/home/u753452625/domains/mariasplace.com/public_html/wordfence-waf.php'
</IfModule>
<IfModule lsapi_module>
